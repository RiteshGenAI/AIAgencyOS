# Backend environment variables
# Copy this file to backend/.env and fill in real values before running.
# Never commit .env files to version control.

BACKEND_DATABASE_URL=postgresql+psycopg2://<db_user>:<db_password>@<db_host>:5432/agency_os
BACKEND_SECRET_KEY=  # generate with: openssl rand -hex 32
BACKEND_ENV=cloud
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=120
BACKEND_AGENTS_SERVICE_URL=http://agents:8081
BACKEND_SENTINEL_URL=http://sentinel:8082
BACKEND_SENTINEL_PROXY_ENABLED=false
BACKEND_CORS_ORIGINS=http://localhost
