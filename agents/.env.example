# Agents service environment variables
# Copy this file to agents/.env and fill in real values before running.
# Never commit .env files to version control.

STRANDS_SENTINEL_BASE_URL=http://backend:8000/internal/sentinel
STRANDS_ENV=cloud

# LLM provider configuration
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://host.docker.internal:11434
# LLM_API_KEY=  # required for openai, anthropic, etc.
